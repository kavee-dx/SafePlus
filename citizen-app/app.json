{
  "expo": {
    "name": "citizen-app",
    "slug": "citizen-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SafePlus uses your location to attach GPS coordinates to an incident report."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SafePlus uses your photos as optional evidence on incident reports.",
          "cameraPermission": "SafePlus uses the camera so you can attach photo or video evidence."
        }
      ]
    ]
  }
}
